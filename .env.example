# Meddah: The Universal Story Engine — Environment Configuration Template
# Copy this file to `.env` for local customization. Never commit `.env`.

# Runtime environment ("development" | "production" | "test")
MEDDAH_ENV=development

# Authoritative server bind settings (`meddah serve`)
MEDDAH_HOST=127.0.0.1
MEDDAH_PORT=8765
MEDDAH_DATA_DIR=./data

# Static administration bearer token for remote headless CLI / Web Admin operations.
# Leave unset for local loopback / UNIX socket admin only; set a strong random secret in production.
# MEDDAH_ADMIN_TOKEN=

# AI Provider Tier Selection:
#   - none   : Tier A — 100% Deterministic / Zero-AI Mode (default, 0 LLM calls, 0 VRAM)
#   - ollama : Tier B — Local 7-14B LLM via Ollama (recommended local baseline)
#   - openai / anthropic / gemini : Tier C — Optional Cloud API upgrade
AI_PROVIDER=none

# Tier B (Local Ollama) settings (only used when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Tier C (Optional Cloud API) credentials — keep blank unless using cloud models
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional Voice / TTS Provider ("none" | "blip" | "piper" | "kokoro" | "os_native")
TTS_PROVIDER=none

# Optional Multiplayer WebSocket Tunnel & Guild Server mode ("table" | "guild-server")
MEDDAH_SERVER_MODE=table
