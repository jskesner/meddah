{
  "manifest": {
    "schema_version": "0.1.0",
    "package_type": "ruleset",
    "package_id": "resource_wager_card_draw",
    "name": "Fate Deck & Momentum Wager",
    "version": "0.1.0",
    "description": "Original card-draw without replacement (52 cards + 2 Jokers) and Momentum resource wagering conformance ruleset.",
    "authors": [
      "Meddah Contributors"
    ],
    "license": "CC0-1.0"
  },
  "declared_primitives": [
    "card_deck_without_replacement",
    "resource_wager",
    "table_shared_deck"
  ],
  "properties": {
    "wits_rating": {
      "prop_id": "wits_rating",
      "label": "Focus",
      "value_kind": "int",
      "default_value": 3,
      "min_value": 0,
      "max_value": 10,
      "category": "attribute"
    }
  },
  "resource_pools": {
    "momentum": {
      "pool_id": "momentum",
      "label": "Momentum",
      "default_current": 4,
      "max_formula": "10",
      "min_value": 0,
      "reset_on": "scene"
    }
  },
  "decks": {
    "fate_deck": {
      "deck_id": "fate_deck",
      "label": "Shared Fate Deck (54 Cards)",
      "scope": "table_shared",
      "cards": [
        "2C", "3C", "4C", "5C", "6C", "7C", "8C", "9C", "10C", "JC", "QC", "KC", "AC",
        "2D", "3D", "4D", "5D", "6D", "7D", "8D", "9D", "10D", "JD", "QD", "KD", "AD",
        "2H", "3H", "4H", "5H", "6H", "7H", "8H", "9H", "10H", "JH", "QH", "KH", "AH",
        "2S", "3S", "4S", "5S", "6S", "7S", "8S", "9S", "10S", "JS", "QS", "KS", "AS",
        "JOKER_RED", "JOKER_BLACK"
      ],
      "card_values": {
        "2C": 2, "3C": 3, "4C": 4, "5C": 5, "6C": 6, "7C": 7, "8C": 8, "9C": 9, "10C": 10, "JC": 11, "QC": 12, "KC": 13, "AC": 14,
        "2D": 2, "3D": 3, "4D": 4, "5D": 5, "6D": 6, "7D": 7, "8D": 8, "9D": 9, "10D": 10, "JD": 11, "QD": 12, "KD": 13, "AD": 14,
        "2H": 2, "3H": 3, "4H": 4, "5H": 5, "6H": 6, "7H": 7, "8H": 8, "9H": 9, "10H": 10, "JH": 11, "QH": 12, "KH": 13, "AH": 14,
        "2S": 2, "3S": 3, "4S": 4, "5S": 5, "6S": 6, "7S": 7, "8S": 8, "9S": 9, "10S": 10, "JS": 11, "QS": 12, "KS": 13, "AS": 14,
        "JOKER_RED": 15, "JOKER_BLACK": 15
      }
    }
  },
  "resolutions": {
    "fate_draw": {
      "mech_id": "fate_draw",
      "label": "Draw From Shared Fate Deck",
      "randomizer": {
        "kind": "card_deck",
        "deck_id": "fate_deck",
        "draw_count": 1,
        "reshuffle_on_empty": false
      },
      "target_formula": "8",
      "tiers": [
        {
          "tier_id": "triumph",
          "label": "High Arcana / Triumph",
          "condition": "@roll.total >= 14",
          "effects": [
            {
              "kind": "advance_clock",
              "target_scope": "scene",
              "target_key": "expedition_progress",
              "formula": "2"
            }
          ]
        },
        {
          "tier_id": "strong_hit",
          "label": "Decisive Card",
          "condition": "@roll.total >= @roll.target",
          "effects": [
            {
              "kind": "advance_clock",
              "target_scope": "scene",
              "target_key": "expedition_progress",
              "formula": "1"
            }
          ]
        },
        {
          "tier_id": "setback",
          "label": "Low Draw Setback",
          "condition": "true",
          "effects": [
            {
              "kind": "modify_pool",
              "target_scope": "self",
              "target_key": "momentum",
              "formula": "-1"
            }
          ]
        }
      ]
    },
    "burn_momentum_wager": {
      "mech_id": "burn_momentum_wager",
      "label": "Burn Momentum Wager",
      "randomizer": {
        "kind": "resource_wager",
        "base_value": 2
      },
      "modifier_formula": "@self.wits_rating",
      "target_formula": "8",
      "tiers": [
        {
          "tier_id": "breakthrough",
          "label": "Momentum Breakthrough",
          "condition": "@roll.total >= @roll.target",
          "effects": [
            {
              "kind": "advance_clock",
              "target_scope": "scene",
              "target_key": "expedition_progress",
              "formula": "2"
            }
          ]
        },
        {
          "tier_id": "narrow",
          "label": "Measured Step",
          "condition": "true",
          "effects": [
            {
              "kind": "advance_clock",
              "target_scope": "scene",
              "target_key": "expedition_progress",
              "formula": "1"
            }
          ]
        }
      ]
    }
  },
  "conditions": {},
  "actions": {
    "draw_fate_card": {
      "action_id": "draw_fate_card",
      "label": "Draw Fate Card",
      "category": "action",
      "resolution_id": "fate_draw"
    },
    "burn_momentum": {
      "action_id": "burn_momentum",
      "label": "Burn Momentum Wager",
      "category": "action",
      "resolution_id": "burn_momentum_wager",
      "pool_costs": {
        "momentum": "3"
      }
    }
  },
  "event_hooks": {},
  "flow_config": {
    "default_mode": "freeform",
    "initiative_formula": "@self.wits_rating"
  }
}
