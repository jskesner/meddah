        "max_skill_value": {
          "default": 100,
          "minimum": 1,
          "title": "Max Skill Value",
          "type": "integer"
        },
        "paradigm": {
          "const": "skill_usage_ticks",
          "default": "skill_usage_ticks",
          "title": "Paradigm",
          "type": "string"
        },
        "tick_tag_prefix": {
          "default": "skill_tick:",
          "title": "Tick Tag Prefix",
          "type": "string"
        }
      },
      "title": "SkillTicksParadigmSpec",
      "type": "object"
    },
