      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Capability Tag"
    },
    "requires_mental_action": {
      "default": false,
      "title": "Requires Mental Action",
      "type": "boolean"
    },
    "requires_somatic_input": {
      "default": false,
      "title": "Requires Somatic Input",
      "type": "boolean"
    },
    "requires_vocal_speech": {
      "default": true,
      "title": "Requires Vocal Speech",
      "type": "boolean"
    },
    "resource_cost_amount": {
      "default": 0,
      "minimum": 0,
      "title": "Resource Cost Amount",
      "type": "integer"
    },
    "resource_cost_pool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
