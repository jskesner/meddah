    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "max_words": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Words"
    },
    "medium_id": {
      "minLength": 1,
