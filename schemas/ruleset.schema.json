{
  "$defs": {
    "ActionBlock": {
      "additionalProperties": false,
      "description": "Player or NPC capability/action/stance/reaction executed through the VM.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "allow_reactions": {
          "default": false,
          "title": "Allow Reactions",
          "type": "boolean"
        },
        "category": {
          "default": "action",
          "enum": [
            "action",
            "power",
            "reaction",
            "stance"
          ],
          "title": "Category",
          "type": "string"
        },
        "default_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EffectSpec"
          },
          "title": "Default Effects",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "modifier_override_formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modifier Override Formula"
        },
        "pool_costs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Pool Costs",
          "type": "object"
        },
        "requires": {
          "default": "true",
          "title": "Requires",
          "type": "string"
        },
        "requires_target": {
          "default": false,
          "title": "Requires Target",
          "type": "boolean"
        },
        "resolution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Id"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "target_override_formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Override Formula"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "action_id",
        "label"
      ],
      "title": "ActionBlock",
      "type": "object"
    },
    "ConditionBlock": {
      "additionalProperties": false,
      "description": "Status condition with declarative property deltas and capability gating tags.",
      "properties": {
        "blocks_tags": {
          "default": [],
