      "type": "object"
    },
    "EffectSpec": {
      "additionalProperties": false,
      "description": "Deterministic state mutation emitted by actions, tiers, or ECA event hooks.",
      "properties": {
        "duration_turns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Turns"
        },
        "forced": {
          "default": false,
          "title": "Forced",
          "type": "boolean"
        },
        "formula": {
          "default": "0",
          "title": "Formula",
          "type": "string"
        },
        "kind": {
          "enum": [
            "modify_pool",
            "set_property",
            "add_condition",
            "remove_condition",
            "advance_clock",
            "emit_message",
            "shift_form",
            "revert_form",
            "set_awareness",
            "apply_disguise",
            "reveal_disguise",
            "transfer_item",
            "mark_provenance"
