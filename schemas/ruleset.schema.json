            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CovertOpsConfigBlock",
      "type": "object"
    },
    "DeckSpec": {
      "additionalProperties": false,
      "description": "Named card deck specification supporting multiple gameplay scopes.",
      "properties": {
        "card_values": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Card Values",
          "type": "object"
