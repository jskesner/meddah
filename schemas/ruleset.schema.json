          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "description": "Creator-assigned semantic version of this package.",
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package_type",
        "package_id",
        "name",
        "version"
      ],
      "title": "PackageManifest",
      "type": "object"
    },
