{
  "$defs": {
    "ConcurrentActivitySelection": {
      "additionalProperties": false,
      "description": "Player or companion activity scheduled to run concurrently during a time skip.",
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "activity_label": {
          "minLength": 1,
          "title": "Activity Label",
          "type": "string"
        },
        "category": {
          "default": "custom",
          "enum": [
            "disguise_don",
            "disguise_doff",
            "rest",
            "ritual",
            "craft",
            "search",
            "watch",
            "custom"
          ],
          "title": "Category",
          "type": "string"
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "activity_label"
      ],
      "title": "ConcurrentActivitySelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hybrid multiplayer time-skip proposal supporting voting & concurrent activities.",
  "properties": {
    "concurrent_activities": {
      "additionalProperties": {
        "$ref": "#/$defs/ConcurrentActivitySelection"
      },
      "title": "Concurrent Activities",
      "type": "object"
    },
    "consensus_mode": {
      "default": "unanimous",
      "enum": [
        "unanimous",
        "majority",
        "gm_only"
      ],
      "title": "Consensus Mode",
      "type": "string"
    },
    "duration_seconds": {
      "minimum": 1,
      "title": "Duration Seconds",
      "type": "integer"
    },
    "elapsed_seconds": {
      "default": 0,
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "integer"
    },
    "interrupted_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interrupted Reason"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "proposal_id": {
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "proposer_entity_id": {
      "minLength": 1,
      "title": "Proposer Entity Id",
      "type": "string"
    },
    "proposer_seat_id": {
      "minLength": 1,
      "title": "Proposer Seat Id",
      "type": "string"
    },
    "required_voter_seat_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Voter Seat Ids",
      "type": "array"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "held",
        "committed",
        "interrupted",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "votes": {
      "additionalProperties": {
        "enum": [
          "approve",
          "hold_act_first",
          "keep_exploring"
        ],
        "type": "string"
      },
      "title": "Votes",
      "type": "object"
    }
  },
  "required": [
    "proposal_id",
    "proposer_entity_id",
    "proposer_seat_id",
    "label",
    "duration_seconds"
  ],
  "title": "TimeSkipProposal",
  "type": "object"
}
